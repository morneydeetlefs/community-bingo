{
  "name": "community-bingo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "stamp":          "node -e \"const fs=require('fs');const sw=fs.readFileSync('sw.js','utf8');fs.writeFileSync('sw.js',sw.replace(/CACHE_VERSION = 'bingo-[^']+'/,\\`CACHE_VERSION = 'bingo-\${Date.now()}'\\`))\"",
    "dev":            "wrangler dev",
    "predeploy":      "npm run stamp",
    "deploy":         "wrangler deploy",
    "migrate:local":  "wrangler d1 execute community-bingo-db --file=schema.sql",
    "migrate:remote": "wrangler d1 execute community-bingo-db --file=schema.sql --remote"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250109.0",
    "typescript":                "^5.4.0",
    "wrangler":                  "^3.0.0"
  }
}
